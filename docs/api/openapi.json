  "info": {
    "description": "Local API for the nuScenes Sensor Data Lake template, providing file upload and management backed by Backblaze B2. This contract documents the template's local API, not a hosted public endpoint.",
    "title": "nuScenes Sensor Data Lake API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
