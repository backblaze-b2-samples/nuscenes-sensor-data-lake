# Backblaze B2 (required) — S3-compatible API only.
# The S3 endpoint is DERIVED from B2_REGION (https://s3.<region>.backblazeb2.com),
# so there is no endpoint URL to keep in sync.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Example of the SHAPE of filled-in values (placeholders — not real credentials):
# B2_APPLICATION_KEY_ID=<25-char key id from the B2 console>
# B2_APPLICATION_KEY=<31-char application key from the B2 console>
# B2_BUCKET_NAME=nuscenes-sensor-lake
# B2_REGION=us-west-004

# Optional: only used to build public object URLs for a public bucket. Leave it
# commented for a private bucket — the app serves every sensor blob via
# presigned URLs and runs without it.
# B2_PUBLIC_URL_BASE=https://nuscenes-sensor-lake.s3.us-west-004.backblazeb2.com

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
